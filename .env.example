# All account, identity and secret values are intentionally blank.
# Copy only after reviewing docs/activation.md; the empty template fails closed.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/bridge.sqlite
# Canonical base64 encoding of exactly 32 random bytes. Keep with DB backups.
STORAGE_KEY=

# deny | dev (loopback + synthetic fixtures only) | oauth (cloud)
AUTH_MODE=deny
DEV_BEARER_TOKEN=
# Exactly one subject from an existing, verified OAuth issuer; not clientInfo.
MCP_OWNER_SUBJECT=

QQ_APP_ID=
QQ_BOT_SECRET=
# Exactly one app-specific author.user_openid; not the numerical QQ account ID.
QQ_OWNER_OPENID=
# documented: api.bot.qq.com; tencent-sdk: bots.qq.com + api.sgroup.qq.com
# tencent-sandbox: bots.qq.com + sandbox.api.sgroup.qq.com; use a separate DB
QQ_API_PROFILE=documented

# Production resource-server settings. No OAuth authorization server is created.
PUBLIC_ORIGIN=
OAUTH_ISSUER=
OAUTH_JWKS_URL=
# Must equal PUBLIC_ORIGIN + /mcp
OAUTH_AUDIENCE=
OAUTH_REQUIRED_SCOPE=qq:bridge

# Exact comma-separated DNS hostnames from the verified ChatGPT callback.
# Empty refuses all subscriptions; no wildcards, IPs, private DNS or redirects.
# With the owner bound, blocked subscribe returns the hostname for manual review.
MCP_CALLBACK_ALLOWED_HOSTS=
# Exact browser origins if a client actually sends Origin. Empty rejects Origin.
MCP_ALLOWED_ORIGINS=

REPLY_TTL_SECONDS=240
SUBSCRIPTION_TTL_SECONDS=86400
QUEUE_LIMIT=100
INBOUND_PER_MINUTE=10
REPLIES_PER_MINUTE=10
MAX_DELIVERY_ATTEMPTS=5
